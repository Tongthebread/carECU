# Compose loads this file. Local API loads it when started with make backend-run.
# Leave DATABASE_URL unset for Compose, which connects to its PostgreSQL service.
# DRIVEEVAL_DATABASE_URL=sqlite:///./driveeval.db
POSTGRES_PASSWORD=driveeval-local
DRIVEEVAL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional AI provider: base URL must include its API prefix, for example /v1.
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_API_KEY=
# Optional result sinks, disabled unless configured. Install extras first.
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT=DriveEval AI
MLFLOW_HTTP_REQUEST_TIMEOUT=5
MLFLOW_HTTP_REQUEST_MAX_RETRIES=1
S3_ENDPOINT_URL=
S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
